# ============================================================
# .env.example — Required environment variables
# Copy this file to .env for local development and fill in real values.
#
# For LOCAL DEV with Wrangler:
#   Copy this to `.dev.vars` (Wrangler reads this file automatically).
#   `.dev.vars` is gitignored — never commit it.
#
# For PRODUCTION (Cloudflare Workers):
#   Set secrets via the Cloudflare dashboard:
#     Workers & Pages → your worker → Settings → Variables & Secrets
#   Or via CLI:
#     wrangler secret put SECRET_NAME
#
# NEVER commit your actual .env or .dev.vars file with real secrets.
# ============================================================

PORT=3001

# Brevo (formerly Sendinblue) HTTP API — works on Cloudflare Workers (no TCP sockets needed)
# Sign up free at https://brevo.com — 300 emails/day, no credit card
# Dashboard > Settings > API Keys > Create API Key (Transactional email: All)
BREVO_API_KEY=xkeysib-your-api-key-here

# Verified sender email address — must match a domain verified in Brevo
# Brevo > Senders & IPs > Domains > Add & verify your domain first
FROM_EMAIL=no-reply@yourdomain.com


# Supabase project URL — found in Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — found in Dashboard > Project Settings > API
# WARNING: This key bypasses ALL Row Level Security policies.
# Never expose it in client-side code or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# Your deployed frontend URL — used in email templates for action button links
# In development: http://localhost:5173
# In production: https://your-app.pages.dev  (or your custom domain)
APP_URL=http://localhost:5173

# The URL of your deployed frontend — used for CORS origin whitelisting
# In production, set this to your live Cloudflare Pages domain (e.g. https://your-app.pages.dev)
FRONTEND_URL=http://localhost:5173

# Set to 'production' when deploying
NODE_ENV=development


# Sentry DSN — optional, for error monitoring in production
# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
